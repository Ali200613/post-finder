{
  "manifest_version": 3,
  "name": "Post Finder helper",
  "version": "1.1",
  "description": "Post Finder searches open in your pinned Reddit, X, Facebook or Bluesky tab. No pinned tab? One tab per site.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.reddit.com/*",
    "*://*.x.com/*",
    "*://x.com/*",
    "*://*.twitter.com/*",
    "*://*.facebook.com/*",
    "*://bsky.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://ali200613.github.io/post-finder/*", "http://localhost:8767/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
