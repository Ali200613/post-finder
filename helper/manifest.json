{
  "manifest_version": 3,
  "name": "Post Finder helper",
  "version": "2.1",
  "description": "Post Finder searches open in your pinned Reddit, X, Facebook or Bluesky tab. It can also read which flair (tag) each Reddit community gives client posts.",
  "key": "",
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://ali200613.github.io/*",
      "http://localhost/*"
    ]
  },
  "optional_host_permissions": [
    "https://www.reddit.com/*"
  ]
}
